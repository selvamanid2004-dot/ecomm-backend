# Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=ecommerce_db
DB_LOGGING=false
DB_SYNCHRONIZE=false

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_antigravity_ecommerce_2026_secure
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_antigravity_2026_refresh
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS Allowed Origins
FRONTEND_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
